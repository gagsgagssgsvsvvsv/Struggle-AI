body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f2f2f2;
}

.app {
  max-width: 450px;
  margin: 30px auto;
  background: white;
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 0 15px rgba(0,0,0,0.1);
}

h2 {
  text-align: center;
}

#chatMessages {
  height: 400px;
  overflow-y: auto;
  border: 1px solid #ddd;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 10px;
}

.message {
  padding: 10px;
  margin: 8px 0;
  border-radius: 10px;
}

.user-message {
  background: #d9fdd3;
  text-align: right;
}

.ai-message {
  background: #eeeeee;
}

.input-area {
  display: flex;
  gap: 10px;
}

#userInput {
  flex: 1;
  padding: 10px;
}

#sendBtn {
  padding: 10px 18px;
  cursor: pointer;
}
